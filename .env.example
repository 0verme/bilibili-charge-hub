APP_ENV=production
APP_HOST=0.0.0.0
APP_PORT=8000
APP_BIND_ADDRESS=0.0.0.0
APP_IMAGE=ghcr.io/0verme/bilibili-charge-hub:latest
APP_DOMAIN=charge.example.com
# Optional external origin used in managed share URLs (e.g. https://charge.example.com)
PUBLIC_BASE_URL=
PUBLIC_HTTP_PORT=80
PUBLIC_HTTPS_PORT=443
APP_TIMEZONE=Asia/Shanghai
COLLECTION_INTERVAL_SECONDS=300
RETENTION_DAYS=90
DATABASE_URL=postgresql+psycopg://bilibili:replace-with-a-random-password@db:5432/bilibili_charge_hub
POSTGRES_DB=bilibili_charge_hub
POSTGRES_USER=bilibili
POSTGRES_PASSWORD=replace-with-a-random-password
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
APP_SECRET_KEY=replace-with-a-random-secret
# Generate with: python -c "from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())"
CREDENTIAL_ENCRYPTION_KEY=replace-with-a-fernet-key
# Optional administrator recovery token. Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
ADMIN_RECOVERY_TOKEN=replace-with-a-random-recovery-token
